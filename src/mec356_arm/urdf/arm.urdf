<?xml version="1.0"?>
<robot name="mec356_arm">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><box size="0.14 0.14 0.08"/></geometry>
      <material name="base_link_paint"><color rgba="0.20 0.25 0.30 1"/></material>
    </visual>
    <collision><origin xyz="0 0 0.04"/><geometry><box size="0.14 0.14 0.08"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.04"/><mass value="0.6"/>
      <inertia ixx="0.0013000000" iyy="0.0013000000"
               izz="0.0019600000" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="L1">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry><box size="0.045 0.045 0.12"/></geometry>
      <material name="L1_paint"><color rgba="0.15 0.48 0.80 1"/></material>
    </visual>
    <collision><origin xyz="0 0 0.06"/><geometry><box size="0.045 0.045 0.12"/></geometry></collision>
    <inertial>
      <origin xyz="0 0 0.06"/><mass value="0.2"/>
      <inertia ixx="0.00027375000" iyy="0.00027375000"
               izz="0.000067500000" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="L2">
    <visual>
      <origin xyz="0.075 0 0"/>
      <geometry><box size="0.15 0.04 0.04"/></geometry>
      <material name="L2_paint"><color rgba="0.18 0.65 0.87 1"/></material>
    </visual>
    <collision><origin xyz="0.075 0 0"/><geometry><box size="0.15 0.04 0.04"/></geometry></collision>
    <inertial>
      <origin xyz="0.075 0 0"/><mass value="0.16"/>
      <inertia ixx="0.000042666667" iyy="0.00032133333"
               izz="0.00032133333" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="L3">
    <visual>
      <origin xyz="0.045 0 0"/>
      <geometry><box size="0.09 0.034 0.034"/></geometry>
      <material name="L3_paint"><color rgba="0.15 0.48 0.80 1"/></material>
    </visual>
    <collision><origin xyz="0.045 0 0"/><geometry><box size="0.09 0.034 0.034"/></geometry></collision>
    <inertial>
      <origin xyz="0.045 0 0"/><mass value="0.1"/>
      <inertia ixx="0.000019266667" iyy="0.000077133333"
               izz="0.000077133333" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <link name="end_effector">
    <visual>
      <origin xyz="0.03 0 0"/>
      <geometry><box size="0.06 0.031 0.028"/></geometry>
      <material name="end_effector_paint"><color rgba="0.90 0.49 0.12 1"/></material>
    </visual>
    <collision><origin xyz="0.03 0 0"/><geometry><box size="0.06 0.031 0.028"/></geometry></collision>
    <inertial>
      <origin xyz="0.03 0 0"/><mass value="0.04"/>
      <inertia ixx="0.0000058166667" iyy="0.000014613333"
               izz="0.000015203333" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="L1"/>
    <origin xyz="0 0 0.08"/><axis xyz="0 0 1"/>
    <limit lower="-1.2" upper="1.2" effort="15" velocity="2"/>
    <dynamics damping="0.25"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="L1"/><child link="L2"/>
    <origin xyz="0 0 0.12"/><axis xyz="0 -1 0"/>
    <limit lower="-1.2" upper="1.2" effort="15" velocity="2"/>
    <dynamics damping="0.25"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="L2"/><child link="L3"/>
    <origin xyz="0.15 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-1.2" upper="1.2" effort="15" velocity="2"/>
    <dynamics damping="0.25"/>
  </joint>
  <joint name="joint4" type="revolute">
    <parent link="L3"/><child link="end_effector"/>
    <origin xyz="0.09 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-1.2" upper="1.2" effort="15" velocity="2"/>
    <dynamics damping="0.25"/>
  </joint>
  <gazebo>
    <joint name="base_anchor" type="fixed"><parent>world</parent><child>base_link</child></joint>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>CONTROLLER_CONFIG_PATH</parameters>
    </plugin>
  </gazebo>
  <ros2_control name="GazeboArm" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="joint1">
      <command_interface name="position"><param name="min">-1.2</param><param name="max">1.2</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"><param name="min">-1.2</param><param name="max">1.2</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"><param name="min">-1.2</param><param name="max">1.2</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"><param name="min">-1.2</param><param name="max">1.2</param></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
